CONFIG_IDF_TARGET="esp32p4"
# WT9932P4-TINY: observed ESP32-P4 silicon v1.0; v3.x binary is incompatible.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# I3C_MASTER_ENABLED is automatically selected on ESP32-P4 when experimental features are on.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_FRAMESIZE_HVGA=y
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_TUSB_PRODUCT="ThermalCam P4"
CONFIG_TUSB_MANUFACTURER="ThermalCam"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# WT9932P4-TINY native CSI: SDA=GPIO7, SCL=GPIO8; OV5647 MIPI RAW8
# 800x640 sensor mode, ISP demosaic into RGB565 V4L2 capture buffers.
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X640_50FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
