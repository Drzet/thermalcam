CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# I3C_MASTER_ENABLED is automatically selected on ESP32-P4 when experimental features are on.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_FRAMESIZE_HVGA=y
CONFIG_UVC_CAM1_FRAMERATE=32
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_TUSB_PRODUCT="ThermalCam P4"
CONFIG_TUSB_MANUFACTURER="ThermalCam"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
